{
  "version": 1,
  "author": "ESP32-S3 pin control POC",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": 190, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": 290, "attrs": { "color": "red", "label": "GPIO13" } },
    { "type": "wokwi-neopixel", "id": "rgb1", "top": -70, "left": 60, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:13", "r1:1", "green", [] ],
    [ "r1:2", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.1", "black", [] ],
    [ "rgb1:DIN", "esp:48", "blue", [] ],
    [ "rgb1:VDD", "esp:5V", "red", [] ],
    [ "rgb1:VSS", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
